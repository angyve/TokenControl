<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>TokenControl</AssemblyName>
    <RootNamespace>TokenControl.App</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets/TokenControl.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <EmbeddedResource Include="Assets/TokenControl.ico" LogicalName="TokenControl.App.Assets.TokenControl.ico" />
  </ItemGroup>

  <!-- The WebView2 package always references its WPF control too, which conflicts with WinForms' WindowsBase. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\TokenControl.Core\TokenControl.Core.csproj" />
  </ItemGroup>

</Project>
